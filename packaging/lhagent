#!/bin/sh
set -eu
# Linux readlink supports resolving both direct invocation and a command symlink.
ENTRY=$(readlink -f -- "$0")
BUNDLE=$(CDPATH= cd -- "$(dirname -- "$ENTRY")" && pwd)
if [ "${1:-}" = --bundle-check ]; then
    shift
    exec "$BUNDLE/runtime/bin/python3.12" -I -B "$BUNDLE/check.py" "$@"
fi
# -I ignores task PYTHONHOME/PYTHONPATH and user site packages for THIS process.
# The original environment remains intact for task commands, including PATH.
exec "$BUNDLE/runtime/bin/python3.12" -I -B -c 'from lhagent import main; main()' "$@"
